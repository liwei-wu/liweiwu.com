# Optional URL submission. INDEXNOW_KEY is public; BAIDU_PUSH_ENDPOINT contains
# the complete API URL issued by Baidu Search Resource Platform and is private.
INDEXNOW_KEY=
BAIDU_PUSH_ENDPOINT=
