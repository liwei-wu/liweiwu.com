# Used only by the offline Markdown translation script.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-sol
TRANSLATION_CONCURRENCY=2

# Set this only when intentionally generating every configured language.
CONFIRM_ALL_TRANSLATIONS=0

# Set this to the final domain before building for production metadata.
NEXT_PUBLIC_SITE_URL=https://liweiwu.com

# Optional webmaster verification values. Add the exact token from each portal.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
SO_SITE_VERIFICATION=
SOGOU_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Optional URL submission. INDEXNOW_KEY is public; BAIDU_PUSH_ENDPOINT contains
# the complete API URL issued by Baidu Search Resource Platform and is private.
INDEXNOW_KEY=
BAIDU_PUSH_ENDPOINT=
