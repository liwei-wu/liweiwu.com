# Optional webmaster verification values. Add the exact token from each portal.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
SO_SITE_VERIFICATION=
SOGOU_SITE_VERIFICATION=
